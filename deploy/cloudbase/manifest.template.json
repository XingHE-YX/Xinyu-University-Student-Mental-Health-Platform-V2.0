{
  "apiVersion": "xinyu.cloudbase/v1",
  "kind": "EnvironmentPair",
  "note": "Template only. Replace placeholders in an ignored local copy or CloudBase secret manager.",
  "environments": {
    "demo": {
      "envId": "${CLOUDBASE_ENV_ID_DEMO}",
      "namespace": "${DEMO_NAMESPACE}",
      "demoMode": true,
      "function": {
        "name": "xinyu-v2-api-demo",
        "runtime": "Python3.11",
        "httpPort": 9000,
        "entrypoint": "scf_bootstrap"
      },
      "hostingOrigin": "${ADMIN_WEB_ORIGIN_DEMO}"
    },
    "authorized": {
      "envId": "${CLOUDBASE_ENV_ID_AUTHORIZED}",
      "namespace": "${AUTHORIZED_NAMESPACE}",
      "demoMode": false,
      "function": {
        "name": "xinyu-v2-api-authorized",
        "runtime": "Python3.11",
        "httpPort": 9000,
        "entrypoint": "scf_bootstrap"
      },
      "hostingOrigin": "${ADMIN_WEB_ORIGIN_AUTHORIZED}"
    }
  },
  "secrets": {
    "demo": [
      "CLOUDBASE_API_KEY_DEMO",
      "WECHAT_APPSECRET_DEMO",
      "ADMIN_PASSWORD_HASH_DEMO",
      "ADMIN_SESSION_SECRET_DEMO"
    ],
    "authorized": [
      "CLOUDBASE_API_KEY_AUTHORIZED",
      "WECHAT_APPSECRET_AUTHORIZED",
      "ADMIN_PASSWORD_HASH_AUTHORIZED",
      "ADMIN_SESSION_SECRET_AUTHORIZED"
    ]
  },
  "optionalSecrets": {
    "demo": ["DEEPSEEK_API_KEY_DEMO"],
    "authorized": ["DEEPSEEK_API_KEY_AUTHORIZED"]
  },
  "artifacts": {
    "functionDependencyLock": "backend/requirements.lock",
    "functionBootstrap": "backend/scf_bootstrap",
    "adminStaticDir": "admin/dist"
  },
  "database": {
    "sourceOfTruth": "docs/develop/BACKEND_STRUCTURE.md",
    "provisionAtDeploy": true,
    "createFromClient": false
  }
}
