page {
  --xinyu-color-paper: #f7f4ee;
  --xinyu-color-surface: #ffffff;
  --xinyu-color-text: #1f2d2b;
  --xinyu-color-text-secondary: #5f6e6a;
  --xinyu-color-text-muted: #8c9a96;
  --xinyu-color-primary: #2e6f68;
  --xinyu-color-primary-pressed: #245b55;
  --xinyu-color-primary-soft: #e8f0ec;
  --xinyu-color-divider: #d7e4df;
  --xinyu-color-safety: #b85c4a;
  --xinyu-color-safety-soft: #f5e7e3;
  --xinyu-color-caution: #c58a3d;
  --xinyu-color-caution-soft: #f6eedb;
  --xinyu-font-sans: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  --xinyu-space-1: 4px;
  --xinyu-space-2: 8px;
  --xinyu-space-3: 12px;
  --xinyu-space-4: 16px;
  --xinyu-space-5: 20px;
  --xinyu-space-6: 24px;
  --xinyu-space-8: 32px;
  --xinyu-space-10: 40px;
  --xinyu-space-12: 48px;
  --xinyu-space-16: 64px;
  background: var(--xinyu-color-paper);
  color: var(--xinyu-color-text);
  font-family: var(--xinyu-font-sans);
  font-size: 16px;
  line-height: 1.625;
}

.page-shell {
  min-height: 100vh;
  padding: var(--xinyu-space-8) var(--xinyu-space-5) calc(var(--xinyu-space-16) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--xinyu-space-16) + env(safe-area-inset-bottom));
}

.page-shell__title {
  margin: 0;
  color: var(--xinyu-color-text);
  font-size: 24px;
  font-weight: 600;
  line-height: 34px;
}

.page-shell__description {
  margin: var(--xinyu-space-3) 0 0;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}

.section-title { margin: 24px 0 12px; color: var(--xinyu-color-text); font-size: 18px; line-height: 28px; font-weight: 500; }
.muted { color: var(--xinyu-color-text-secondary); font-size: 14px; line-height: 22px; }
.surface { padding: 20px; background: var(--xinyu-color-surface); border: 1px solid var(--xinyu-color-divider); border-radius: 8px; }
.surface + .surface { margin-top: 12px; }
.link-row { display: flex; align-items: center; justify-content: space-between; min-height: 52px; border-bottom: 1px solid var(--xinyu-color-divider); color: var(--xinyu-color-text); }
.link-row:last-child { border-bottom: 0; }
.status-chip { display: inline-block; padding: 4px 8px; border-radius: 4px; background: var(--xinyu-color-primary-soft); color: var(--xinyu-color-primary-pressed); font-size: 12px; line-height: 18px; }
.status-chip--waiting { background: var(--xinyu-color-caution-soft); color: var(--xinyu-color-caution); }
.status-chip--safety { background: var(--xinyu-color-safety-soft); color: var(--xinyu-color-safety); }
.textarea { width: 100%; min-height: 180px; box-sizing: border-box; padding: 12px; background: var(--xinyu-color-surface); border: 1px solid var(--xinyu-color-divider); border-radius: 8px; font-size: 16px; line-height: 26px; }
.input { width: 100%; box-sizing: border-box; height: 48px; margin-top: 8px; padding: 0 12px; background: var(--xinyu-color-surface); border: 1px solid var(--xinyu-color-divider); border-radius: 8px; font-size: 16px; }
.option { display: flex; align-items: center; min-height: 52px; margin-top: 8px; padding: 0 16px; box-sizing: border-box; background: var(--xinyu-color-surface); border: 1px solid var(--xinyu-color-divider); border-radius: 8px; color: var(--xinyu-color-text); }
.option--selected { border: 2px solid var(--xinyu-color-primary); background: var(--xinyu-color-primary-soft); color: var(--xinyu-color-primary-pressed); }
.progress { height: 4px; margin: 16px 0 24px; background: var(--xinyu-color-divider); border-radius: 4px; overflow: hidden; }
.progress__bar { height: 100%; background: var(--xinyu-color-primary); }
.resource + .resource { margin-top: 12px; }
