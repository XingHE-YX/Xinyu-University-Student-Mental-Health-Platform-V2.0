page {
  background: #f7f4ee;
  color: #1f2d2b;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 16px;
  line-height: 1.625;
}

.page-shell {
  min-height: 100vh;
  padding: 32px 20px 64px;
}

.page-shell__title {
  margin: 0;
  color: #1f2d2b;
  font-size: 24px;
  font-weight: 600;
  line-height: 34px;
}

.page-shell__description {
  margin: 12px 0 0;
  color: #5f6e6a;
  font-size: 16px;
  line-height: 26px;
}
