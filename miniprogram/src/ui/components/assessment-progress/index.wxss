.assessment-progress__muted {
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.assessment-progress__segments {
  display: flex;
  gap: 4px;
  margin: 16px 0 24px;
}

.assessment-progress__segment {
  flex: 1;
  height: 4px;
  background: var(--xinyu-color-divider);
  border-radius: 4px;
}

.assessment-progress__segment--active {
  background: var(--xinyu-color-primary);
}

