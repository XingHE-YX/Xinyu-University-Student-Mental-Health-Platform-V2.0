<view class="page-assessment-center app-page app-page--padded page-assessment-center--main">
  <view class="page-assessment-center__page-heading">
    <text class="page-assessment-center__page-heading-title">自测</text>
  </view>
  <view class="page-assessment-center__page-intro">
    <text class="page-assessment-center__page-intro-line">把最近的状态记下来。</text>
    <text class="page-assessment-center__page-intro-line">不需要一次完成全部。</text>
  </view>

  <view wx:if="{{loading && !modules.length}}" class="page-assessment-center__reading-block"><text class="page-assessment-center__reading-block-body">正在加载自测模块…</text></view>
  <state-message wx:elif="{{error && !modules.length}}" title="暂时没有加载到自测" message="请稍后重新试试。" action-label="重新试试" bindaction="load"></state-message>
  <view wx:elif="{{!modules.length}}" class="page-assessment-center__reading-block"><text class="page-assessment-center__reading-block-body">暂时没有可用的自测模块。</text></view>
  <view wx:else class="page-assessment-center__plain-list page-assessment-center__assessment-list">
    <view wx:for="{{modules}}" wx:key="key" class="page-assessment-center__plain-list-item page-assessment-center__plain-list-item--stacked page-assessment-center__assessment-row" data-key="{{item.key}}" bindtap="begin">
      <view class="page-assessment-center__assessment-row-content">
        <text class="page-assessment-center__plain-list-title">{{item.title}}</text>
        <text class="page-assessment-center__plain-list-meta">{{item.purpose}}</text>
        <text class="page-assessment-center__plain-list-meta">{{item.duration}}<text wx:if="{{item.questionCount}}"> · {{item.questionCount}} 题</text></text>
        <text class="page-assessment-center__plain-list-status">{{item.lastCompletedAt ? '最近一次：' + item.lastCompletedAt : '尚未记录'}}</text>
      </view>
      <text class="page-assessment-center__plain-list-chevron">›</text>
    </view>
  </view>

  <view class="page-assessment-center__content-section page-assessment-center__assessment-history">
    <view class="page-assessment-center__plain-list">
      <view class="page-assessment-center__plain-list-item" bindtap="history"><text class="page-assessment-center__plain-list-title">查看全部记录</text><text class="page-assessment-center__plain-list-chevron">›</text></view>
    </view>
    <text class="page-assessment-center__content-section-hint">记录只属于你，不是诊断。</text>
  </view>
  <state-message wx:if="{{error && modules.length}}" title="暂时无法更新" message="{{error}}" action-label="重新试试" bindaction="load"></state-message>
</view>
