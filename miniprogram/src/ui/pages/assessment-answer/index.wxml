<view class="page-assessment-answer app-page app-page--padded"><top-bar title="{{title}}" back="true"></top-bar><assessment-progress current="{{currentIndex + 1}}" total="{{questions.length}}"></assessment-progress><view wx:if="{{questions[currentIndex]}}" class="page-assessment-answer__surface"><view class="page-assessment-answer__question">{{questions[currentIndex].prompt}}</view><view wx:for="{{questions[currentIndex].options}}" wx:key="*this" class="page-assessment-answer__option {{selected === index ? 'page-assessment-answer__option--selected' : ''}}" data-value="{{index}}" bindtap="choose">{{item}}</view></view><state-message wx:if="{{error}}" title="还不能提交" message="{{error}}"></state-message><view class="page-assessment-answer__answer-actions"><button class="page-assessment-answer__secondary-action" bindtap="previous" disabled="{{currentIndex === 0}}">上一题</button><button wx:if="{{currentIndex < questions.length - 1}}" class="page-assessment-answer__secondary-action" bindtap="next">下一题</button><view wx:else class="page-assessment-answer__submit"><primary-button inline label="提交本次观察" loading="{{submitting}}" bindaction="submit"></primary-button></view></view><button class="page-assessment-answer__leave-action" bindtap="askLeave">离开本次观察</button><confirm-sheet visible="{{showLeave}}" title="回答尚未完成" message="离开后不会生成结果，当前回答只保留在本次页面会话中。" confirm-label="确认离开" bindconfirm="leave" bindcancel="cancelLeave"></confirm-sheet></view>
