<view class="page-my app-page app-page--padded page-my--main">
  <view class="page-my__page-heading">
    <text class="page-my__page-heading-title">我的</text>
    <text class="page-my__page-heading-greeting">记录只属于你，树洞中只展示匿名身份。</text>
  </view>

  <view wx:if="{{loading}}" class="page-my__reading-block"><text class="page-my__reading-block-body">正在准备你的空间…</text></view>
  <state-message wx:elif="{{error}}" title="账户信息暂时无法读取" message="请稍后重新试试。" action-label="重新试试" bindaction="load"></state-message>
  <view wx:elif="{{profile}}" class="page-my__identity-summary">
    <text class="page-my__identity-summary-label">在树洞中的身份</text>
    <text class="page-my__identity-summary-name">{{profile.displayName || '匿名同学'}}</text>
    <text class="page-my__identity-summary-body">真实姓名和学号不会公开。</text>
    <text wx:if="{{profile.accountStatus === 'recovery'}}" class="page-my__identity-summary-body">账户处于 30 天恢复期。</text>
  </view>

  <view class="page-my__content-section page-my__my-space">
    <text class="page-my__content-section-title">我的空间</text>
    <view class="page-my__plain-list">
      <view wx:if="{{profile && !profile.identityVerified}}" class="page-my__plain-list-item" data-path="/ui/pages/identity-verification/index?from=my" bindtap="open"><text class="page-my__plain-list-title">完成身份核验</text><text class="page-my__plain-list-chevron">›</text></view>
      <view class="page-my__plain-list-item" data-path="/ui/pages/anonymous-identity/index" bindtap="open"><text class="page-my__plain-list-title">在树洞中的身份</text><text class="page-my__plain-list-chevron">›</text></view>
      <view class="page-my__plain-list-item" data-path="/ui/pages/my-content/index" bindtap="open"><text class="page-my__plain-list-title">我的树洞内容</text><text class="page-my__plain-list-chevron">›</text></view>
      <view class="page-my__plain-list-item" data-path="/ui/pages/history/index" bindtap="open"><text class="page-my__plain-list-title">我的记录</text><text class="page-my__plain-list-chevron">›</text></view>
      <view class="page-my__plain-list-item" data-path="/ui/pages/support-resources/index" bindtap="open"><text class="page-my__plain-list-title">支持资源</text><text class="page-my__plain-list-chevron">›</text></view>
      <view class="page-my__plain-list-item" data-path="/ui/pages/privacy/index" bindtap="open"><text class="page-my__plain-list-title">数据与隐私</text><text class="page-my__plain-list-chevron">›</text></view>
      <view wx:if="{{profile && profile.accountStatus === 'recovery'}}" class="page-my__plain-list-item" data-path="/ui/pages/account-recover/index" bindtap="open"><text class="page-my__plain-list-title">恢复账户</text><text class="page-my__plain-list-chevron">›</text></view>
      <view wx:elif="{{profile}}" class="page-my__plain-list-item" data-path="/ui/pages/account-stop/index" bindtap="open"><text class="page-my__plain-list-title">停止使用账户</text><text class="page-my__plain-list-chevron">›</text></view>
      <view class="page-my__plain-list-item" bindtap="logout"><text class="page-my__plain-list-title">{{loggingOut ? '正在退出…' : '退出登录'}}</text><text class="page-my__plain-list-chevron">›</text></view>
    </view>
  </view>
</view>
