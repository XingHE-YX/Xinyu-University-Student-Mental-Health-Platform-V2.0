.page-my-content__muted {
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-my-content__surface {
  padding: 20px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
}

.page-my-content__surface + .page-my-content__surface {
  margin-top: 12px;
}

.page-my-content__status-chip {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 4px;
  background: var(--xinyu-color-primary-soft);
  color: var(--xinyu-color-primary-pressed);
  font-size: 12px;
  line-height: 18px;
}
.page-my-content__post-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
