.page-account-recover__title {
  margin: 0;
  color: var(--xinyu-color-text);
  font-size: 24px;
  font-weight: 600;
  line-height: 34px;
}

.page-account-recover__description {
  margin: var(--xinyu-space-3) 0 0;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}

.page-account-recover__surface {
  padding: 20px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
}

.page-account-recover__surface + .page-account-recover__surface {
  margin-top: 12px;
}
