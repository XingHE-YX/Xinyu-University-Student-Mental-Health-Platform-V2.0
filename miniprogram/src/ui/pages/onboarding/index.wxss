.page-onboarding__title {
  margin: 0;
  color: var(--xinyu-color-text);
  font-size: 24px;
  font-weight: 600;
  line-height: 34px;
}

.page-onboarding__description {
  margin: var(--xinyu-space-3) 0 0;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}

.page-onboarding__section-title {
  margin: 24px 0 12px;
  color: var(--xinyu-color-text);
  font-size: 18px;
  line-height: 28px;
  font-weight: 500;
}

.page-onboarding__muted {
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-onboarding__surface {
  padding: 20px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
}

.page-onboarding__surface + .page-onboarding__surface {
  margin-top: 12px;
}

.page-onboarding__option {
  display: flex;
  align-items: center;
  min-height: 52px;
  margin-top: 8px;
  padding: 0 16px;
  box-sizing: border-box;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
  color: var(--xinyu-color-text);
}

.page-onboarding__option--selected {
  border: 2px solid var(--xinyu-color-primary);
  background: var(--xinyu-color-primary-soft);
  color: var(--xinyu-color-primary-pressed);
}
