<view class="page-today app-page app-page--padded page-today--main">
  <view class="page-today__page-heading">
    <text class="page-today__page-heading-date">{{todayDate}}</text>
    <text class="page-today__page-heading-title">今日</text>
    <text class="page-today__page-heading-greeting">{{greeting}}</text>
  </view>

  <view wx:if="{{loading && !loaded}}" class="page-today__reading-block">
    <text class="page-today__reading-block-body">正在准备今天的内容…</text>
  </view>

  <block wx:else>
    <view class="page-today__reading-block page-today__reading-block--quote">
      <text class="page-today__reading-block-label">给今天的一句话</text>
      <text wx:if="{{quote && quote.available}}" class="page-today__reading-block-title">{{quote.text}}</text>
      <text wx:if="{{quote && quote.available}}" class="page-today__reading-block-body">{{quote.attribution}}</text>
      <text wx:else class="page-today__reading-block-body">先照顾好自己的节奏。</text>
    </view>

    <view class="page-today__content-section">
      <text class="page-today__content-section-title">此时此刻</text>
      <view class="page-today__reading-block page-today__reading-block--mood">
        <view wx:if="{{error && !loaded}}" class="page-today__inline-error"><text>暂时没有读取到今天的记录。</text><button class="page-today__inline-error-action" bindtap="load">重新试试</button></view>
        <view wx:elif="{{mood}}">
          <text class="page-today__reading-block-title">今天的心情：{{mood.mood}}</text>
          <text class="page-today__reading-block-body">已记录 · 记录于 {{mood.recordedAt}}</text>
          <view class="page-today__reading-block-action" bindtap="openMoodSheet"><text>再看一眼</text><text class="page-today__reading-block-chevron">›</text></view>
        </view>
        <block wx:else>
          <text class="page-today__reading-block-body page-today__reading-block-body--strong">还没有记录此刻</text>
          <view class="page-today__reading-block-action" bindtap="openMoodSheet"><text>记录此刻</text><text class="page-today__reading-block-chevron">›</text></view>
        </block>
      </view>
    </view>

    <view class="page-today__content-section">
      <view class="page-today__section-heading"><text class="page-today__content-section-title">最近的自我观察</text><button class="page-today__section-heading-action" bindtap="goAssessment">自测 ›</button></view>
      <text wx:if="{{!loaded}}" class="page-today__reading-block-body">记录暂时无法读取。</text>
      <view class="page-today__plain-list">
        <view wx:for="{{observations}}" wx:key="key" class="page-today__plain-list-item" data-key="{{item.key}}" bindtap="openObservation">
          <view><text class="page-today__plain-list-title">{{item.title}}</text><text class="page-today__plain-list-meta">{{item.summary}}</text></view>
          <text class="page-today__plain-list-chevron">›</text>
        </view>
      </view>
    </view>

    <view class="page-today__content-section">
      <text class="page-today__content-section-title">树洞与支持</text>
      <view class="page-today__plain-list">
        <view class="page-today__plain-list-item" bindtap="goTreehole"><text class="page-today__plain-list-title">去树洞读一会儿</text><text class="page-today__plain-list-chevron">›</text></view>
        <view class="page-today__plain-list-item" bindtap="goSupport"><text class="page-today__plain-list-title">查看支持资源</text><text class="page-today__plain-list-chevron">›</text></view>
      </view>
    </view>
  </block>

  <view wx:if="{{error && loaded}}" class="page-today__inline-error"><text>暂时无法更新，当前显示的是上次读取的记录。</text><button class="page-today__inline-error-action" bindtap="load">重新试试</button></view>

  <view wx:if="{{showMoodSheet}}" class="page-today__mood-sheet">
    <view class="page-today__mood-sheet-mask" bindtap="closeMoodSheet" catchtouchmove="preventScroll"></view>
    <view class="page-today__mood-sheet-panel">
      <block wx:if="{{mood}}">
        <text class="page-today__mood-sheet-eyebrow">已记下此刻</text>
        <text class="page-today__mood-sheet-title">{{mood.mood}}</text>
        <button class="page-today__mood-sheet-primary" bindtap="closeMoodSheet">再看一眼</button>
      </block>
      <block wx:else>
        <text class="page-today__mood-sheet-eyebrow">此时此刻</text>
        <text class="page-today__mood-sheet-title">你的心情更接近哪一种？</text>
        <view class="page-today__mood-grid">
          <view wx:for="{{moods}}" wx:key="code" class="page-today__mood-option {{selectedMood === item.code ? 'page-today__mood-option--selected' : ''}}" data-mood="{{item.code}}" bindtap="selectMood">
            <text class="page-today__mood-option-mark">{{selectedMood === item.code ? '●' : '○'}}</text>
            <text>{{item.label}}</text>
          </view>
        </view>
        <text class="page-today__mood-sheet-hint">今天只记录一次，之后不会提供修改入口。</text>
        <text wx:if="{{moodError}}" class="page-today__mood-sheet-error">{{moodError}}</text>
        <button class="page-today__mood-sheet-primary" disabled="{{!selectedMood || saving}}" bindtap="saveMood">{{saving ? '正在保存…' : moodError ? '重新试试' : '保存今天的心情'}}</button>
        <button class="page-today__mood-sheet-secondary" disabled="{{saving}}" bindtap="closeMoodSheet">稍后再说</button>
      </block>
    </view>
  </view>
</view>
