.page-today--main {
  max-width: 480px;
  margin: 0 auto;
  padding-top: 20px;
  padding-bottom: 32px;
}

.page-today__page-heading {
  margin-bottom: 24px;
}

.page-today__page-heading-date {
  display: block;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-today__page-heading-title {
  display: block;
  margin-top: 2px;
  color: var(--xinyu-color-text);
  font-size: 28px;
  line-height: 38px;
  font-weight: 600;
}

.page-today__page-heading-greeting {
  display: block;
  margin-top: 4px;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}

.page-today__reading-block {
  padding: 20px 0;
  border-top: 1px solid var(--xinyu-color-divider);
}

.page-today__reading-block:last-of-type {
  border-bottom: 1px solid var(--xinyu-color-divider);
}

.page-today__reading-block-label {
  display: block;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-today__reading-block-title {
  display: block;
  margin-top: 4px;
  color: var(--xinyu-color-text);
  font-size: 20px;
  line-height: 30px;
  font-weight: 500;
}

.page-today__reading-block-body {
  display: block;
  margin-top: 8px;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}

.page-today__reading-block-body--strong {
  color: var(--xinyu-color-text);
}

.page-today__content-section {
  margin-top: 32px;
}

.page-today__content-section-title {
  display: block;
  margin-bottom: 12px;
  color: var(--xinyu-color-text);
  font-size: 18px;
  line-height: 28px;
  font-weight: 500;
}

.page-today__plain-list {
  border-top: 1px solid var(--xinyu-color-divider);
}

.page-today__plain-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60px;
  padding: 12px 0;
  box-sizing: border-box;
  border-bottom: 1px solid var(--xinyu-color-divider);
}

.page-today__plain-list-item > view {
  min-width: 0;
  flex: 1;
  overflow-wrap: break-word;
}

.page-today__section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.page-today__section-heading .page-today__content-section-title {
  margin-bottom: 0;
}

.page-today__section-heading-action {
  flex: 0 0 auto;
  min-height: 44px;
  margin: 0 0 0 12px;
  padding: 8px 0 8px 8px;
  background: transparent;
  color: var(--xinyu-color-primary);
  font-size: 14px;
  line-height: 28px;
}

.page-today__section-heading-action::after {
  border: 0;
}

.page-today__plain-list-title {
  display: block;
  color: var(--xinyu-color-text);
  font-size: 16px;
  line-height: 26px;
}

.page-today__plain-list-meta {
  display: block;
  margin-top: 2px;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-today__plain-list-chevron {
  flex: 0 0 auto;
  margin-left: 16px;
  color: var(--xinyu-color-text-secondary);
  font-size: 22px;
  line-height: 22px;
}

.page-today__inline-error {
  margin-top: 16px;
  padding: 12px 0;
  border-top: 1px solid var(--xinyu-color-divider);
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-today__inline-error-action {
  min-height: 44px;
  margin: 4px 0 0;
  padding: 8px 0;
  border: 0;
  background: transparent;
  color: var(--xinyu-color-primary);
  font-size: 14px;
  line-height: 28px;
  text-align: left;
  text-decoration: underline;
}

.page-today__inline-error-action::after {
  border: 0;
}

.page-today__mood-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 20px;
}

.page-today__mood-option {
  display: flex;
  align-items: center;
  min-height: 52px;
  padding: 0 12px;
  box-sizing: border-box;
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
  background: var(--xinyu-color-surface);
  color: var(--xinyu-color-text);
  font-size: 16px;
  line-height: 26px;
}

.page-today__mood-option--selected {
  border-color: var(--xinyu-color-primary);
  background: var(--xinyu-color-primary-soft);
  color: var(--xinyu-color-primary-pressed);
}

.page-today__mood-option-mark {
  width: 24px;
  color: var(--xinyu-color-primary);
}

.page-today__reading-block--mood {
  padding-top: 0;
  border-top: 0;
}

.page-today__reading-block-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48px;
  margin-top: 8px;
  color: var(--xinyu-color-primary);
  font-size: 16px;
  line-height: 26px;
}

.page-today__reading-block-chevron {
  font-size: 24px;
  line-height: 24px;
}

.page-today__mood-sheet {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.page-today__mood-sheet-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(31, 45, 43, .28);
}

.page-today__mood-sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 90vh;
  max-width: 480px;
  margin: 0 auto;
  overflow-y: auto;
  padding: 24px 20px calc(20px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 8px 8px 0 0;
  background: var(--xinyu-color-surface);
}

.page-today__mood-sheet-eyebrow {
  display: block;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-today__mood-sheet-title {
  display: block;
  margin-top: 4px;
  color: var(--xinyu-color-text);
  font-size: 20px;
  line-height: 30px;
  font-weight: 500;
}

.page-today__mood-sheet-hint {
  display: block;
  margin-top: 12px;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-today__mood-sheet-error {
  display: block;
  margin-top: 8px;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-today__mood-sheet-primary, .page-today__mood-sheet-secondary {
  width: 100%;
  height: 48px;
  margin-top: 16px;
  border: 0;
  border-radius: 8px;
  font-size: 16px;
  line-height: 48px;
}

.page-today__mood-sheet-primary {
  background: var(--xinyu-color-primary);
  color: var(--xinyu-color-surface);
}

.page-today__mood-sheet-primary[disabled] {
  background: var(--xinyu-color-primary-soft);
  color: var(--xinyu-color-text-muted);
}

.page-today__mood-sheet-secondary {
  margin-top: 8px;
  background: transparent;
  color: var(--xinyu-color-text-secondary);
}

.page-today__mood-sheet-primary::after, .page-today__mood-sheet-secondary::after {
  border: 0;
}
