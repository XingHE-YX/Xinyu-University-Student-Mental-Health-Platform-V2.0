.page-assessment-result__section-title {
  margin: 24px 0 12px;
  color: var(--xinyu-color-text);
  font-size: 18px;
  line-height: 28px;
  font-weight: 500;
}

.page-assessment-result__section-title--first {
  margin-top: 0;
}

.page-assessment-result__muted {
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-assessment-result__surface {
  padding: 20px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
}

.page-assessment-result__surface + .page-assessment-result__surface {
  margin-top: 12px;
}

.page-assessment-result__link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 52px;
  border-bottom: 1px solid var(--xinyu-color-divider);
  color: var(--xinyu-color-text);
}

.page-assessment-result__link-row:last-child {
  border-bottom: 0;
}

.page-assessment-result__result-score {
  margin-top: 16px;
  color: var(--xinyu-color-primary-pressed);
  font-size: 32px;
  line-height: 42px;
  font-weight: 600;
}

.page-assessment-result__result-kind {
  margin-top: 8px;
  color: var(--xinyu-color-primary);
  font-size: 18px;
  line-height: 28px;
  font-weight: 500;
}

.page-assessment-result__result-text {
  margin-top: 12px;
  font-size: 16px;
  line-height: 26px;
}

.page-assessment-result__result-note {
  margin-top: 16px;
}

.page-assessment-result__ai-assist {
  margin-top: 24px;
}

.page-assessment-result__ai-list, .page-assessment-result__ai-steps {
  margin-top: 12px;
}

.page-assessment-result__ai-steps {
  padding-top: 12px;
  border-top: 1px solid var(--xinyu-color-divider);
}

.page-assessment-result__ai-list-item {
  margin-top: 8px;
  padding-left: 16px;
  position: relative;
  line-height: 26px;
}

.page-assessment-result__ai-list-item::before {
  content: '·';
  position: absolute;
  left: 0;
  color: var(--xinyu-color-primary);
}
