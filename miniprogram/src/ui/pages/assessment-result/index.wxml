<view class="page-assessment-result app-page app-page--padded"><top-bar title="观察结果"></top-bar><state-message wx:if="{{error}}" title="暂时无法展示" message="{{error}}" action-label="返回自测" bindaction="again"></state-message><view wx:if="{{result}}"><view class="page-assessment-result__surface"><view class="page-assessment-result__muted">{{result.title}} · {{result.completedAt}}</view><view wx:if="{{result.score !== null}}" class="page-assessment-result__result-score">{{result.score}}</view><view class="page-assessment-result__result-kind">{{result.kind === 'higher_score' ? '这次观察提示可以多留意' : result.kind === 'insufficient_data' ? '数据不足' : '本次观察已完成'}}</view><view class="page-assessment-result__result-text">{{result.interpretation}}</view><view wx:if="{{result.sleepDimensions}}" class="page-assessment-result__sleep-dimensions"><view wx:for="{{result.sleepDimensions}}" wx:key="name" class="page-assessment-result__link-row"><text>{{item.name}}</text><text class="page-assessment-result__muted">{{item.summary}}</text></view></view></view><view wx:if="{{result.aiAssist && result.kind !== 'safety_support' && result.module !== 'sleep'}}" class="page-assessment-result__surface page-assessment-result__ai-assist"><view class="page-assessment-result__section-title page-assessment-result__section-title--first">辅助说明</view><view wx:if="{{result.aiAssist.status === 'adopted'}}"><view class="page-assessment-result__result-text">{{result.aiAssist.summary}}</view><view wx:if="{{result.aiAssist.observations && result.aiAssist.observations.length}}" class="page-assessment-result__ai-list"><view wx:for="{{result.aiAssist.observations}}" wx:key="*this" class="page-assessment-result__ai-list-item">{{item}}</view></view><view wx:if="{{result.aiAssist.practicalSteps && result.aiAssist.practicalSteps.length}}" class="page-assessment-result__ai-steps"><view class="page-assessment-result__muted">可以考虑</view><view wx:for="{{result.aiAssist.practicalSteps}}" wx:key="*this" class="page-assessment-result__ai-list-item">{{item}}</view></view><view class="page-assessment-result__muted page-assessment-result__result-note">{{result.aiAssist.boundaryNotice}}</view></view><view wx:else class="page-assessment-result__muted">{{result.aiAssist.fallbackCopy || 'AI 辅助解读暂时不可用，当前使用固定规则说明'}}</view></view><view class="page-assessment-result__surface"><view class="page-assessment-result__section-title page-assessment-result__section-title--first">下一步</view><view class="page-assessment-result__muted">{{result.nextStep}}</view><view class="page-assessment-result__muted page-assessment-result__result-note">这是一次自我观察，不是诊断。你可以按自己的节奏决定是否寻求支持。</view></view><primary-button label="查看支持资源" bindaction="support"></primary-button><primary-button wx:if="{{result.kind !== 'safety_support'}}" label="查看历史记录" secondary="true" bindaction="history"></primary-button><primary-button label="再做一次观察" secondary="true" bindaction="again"></primary-button></view></view>
