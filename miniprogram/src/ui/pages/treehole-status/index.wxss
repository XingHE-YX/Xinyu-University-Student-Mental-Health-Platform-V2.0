.page-treehole-status__muted {
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.page-treehole-status__surface {
  padding: 20px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
}

.page-treehole-status__surface + .page-treehole-status__surface {
  margin-top: 12px;
}

.page-treehole-status__status-chip {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 4px;
  background: var(--xinyu-color-primary-soft);
  color: var(--xinyu-color-primary-pressed);
  font-size: 12px;
  line-height: 18px;
}

.page-treehole-status__status-chip--waiting {
  background: var(--xinyu-color-caution-soft);
  color: var(--xinyu-color-caution);
}

.page-treehole-status__status-chip--safety {
  background: var(--xinyu-color-safety-soft);
  color: var(--xinyu-color-safety);
}

.page-treehole-status__status-message {
  margin: 16px 0;
  font-size: 16px;
  line-height: 26px;
}
