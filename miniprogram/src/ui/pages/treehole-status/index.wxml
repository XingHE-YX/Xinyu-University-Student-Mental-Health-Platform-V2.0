<view class="page-treehole-status app-page app-page--padded"><top-bar title="帖子状态"></top-bar><view class="page-treehole-status__surface"><text class="page-treehole-status__status-chip {{status === 'checking' || status === 'pending_confirmation' ? 'page-treehole-status__status-chip--waiting' : status === 'safety_priority' ? 'page-treehole-status__status-chip--safety' : ''}}">{{status === 'published' ? '已公开' : status === 'protected' ? '保护展示' : status === 'checking' ? '检查中' : status === 'pending_confirmation' ? '等待确认' : status === 'unpublished' ? '未公开' : status === 'safety_priority' ? '安全优先' : status === 'deleted' ? '已删除' : '状态未知'}}</text><view class="page-treehole-status__status-message">{{message}}</view><view class="page-treehole-status__muted">帖子编号：{{id}}</view></view><primary-button label="回到树洞" bindaction="back"></primary-button></view>
