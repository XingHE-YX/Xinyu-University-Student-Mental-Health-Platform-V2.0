.page-account-stop__description {
  margin: var(--xinyu-space-3) 0 0;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}

.page-account-stop__section-title {
  margin: 24px 0 12px;
  color: var(--xinyu-color-text);
  font-size: 18px;
  line-height: 28px;
  font-weight: 500;
}

.page-account-stop__description--first {
  margin-top: 0;
}

.page-account-stop__surface {
  padding: 20px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
}

.page-account-stop__surface + .page-account-stop__surface {
  margin-top: 12px;
}

.page-account-stop__input {
  width: 100%;
  box-sizing: border-box;
  height: 48px;
  margin-top: 8px;
  padding: 0 12px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
  font-size: 16px;
}
