<view><view wx:for="{{resources}}" wx:key="id" class="surface resource"><view class="section-title section-title--first">{{item.title}}</view><view class="muted resource-description">{{item.description}}</view><view wx:if="{{item.availabilityText}}" class="resource-status">{{item.availabilityText}}</view><view wx:if="{{item.sourceText}}" class="muted resource-meta">来源：{{item.sourceText}}</view><button wx:if="{{item.phone}}" class="resource-action" data-phone="{{item.phone}}" bindtap="call">拨打 {{item.phone}}</button></view></view>
