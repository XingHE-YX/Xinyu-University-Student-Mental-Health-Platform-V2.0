{
  "name": "xinyu-v2-miniprogram",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "description": "心语 V2 原生微信小程序学生端",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./tests/helpers/register-ts.mjs --test tests/ui/*.test.mjs tests/business/*.test.mjs tests/utils/*.test.mjs",
    "test:ui": "node --import ./tests/helpers/register-ts.mjs --test tests/ui/*.test.mjs",
    "test:business": "node --import ./tests/helpers/register-ts.mjs --test tests/business/*.test.mjs",
    "test:utils": "node --import ./tests/helpers/register-ts.mjs --test tests/utils/*.test.mjs",
    "test:structure": "node --import ./tests/helpers/register-ts.mjs --test tests/ui/main-pages-structure.test.mjs tests/ui/source-structure.test.mjs tests/ui/styles.test.mjs tests/business/architecture.test.mjs"
  },
  "devDependencies": {
    "miniprogram-api-typings": "5.2.3",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "typescript": "7.0.2"
  }
}
