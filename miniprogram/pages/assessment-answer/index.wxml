<view class="page-container page-container--padded"><top-bar title="{{title}}" back="true"></top-bar><view class="muted">第 {{currentIndex + 1}} 题 / 共 {{questions.length}} 题</view><view class="progress"><view class="progress__bar" style="width:{{((currentIndex + 1) / questions.length) * 100}}%"></view></view><view wx:if="{{questions[currentIndex]}}" class="surface"><view class="question">{{questions[currentIndex].prompt}}</view><view wx:for="{{questions[currentIndex].options}}" wx:key="*this" class="option {{selected === index ? 'option--selected' : ''}}" data-value="{{index}}" bindtap="choose">{{item}}</view></view><state-message wx:if="{{error}}" title="还不能提交" message="{{error}}"></state-message><view class="answer-actions"><button class="secondary-action" bindtap="previous" disabled="{{currentIndex === 0}}">上一题</button><button wx:if="{{currentIndex < questions.length - 1}}" class="secondary-action" bindtap="next">下一题</button><primary-button wx:else label="提交本次观察" loading="{{submitting}}" bindaction="submit"></primary-button></view><button class="leave-action" bindtap="askLeave">离开本次观察</button><confirm-sheet visible="{{showLeave}}" title="回答尚未完成" message="离开后不会生成结果，当前回答只保留在本次页面会话中。" confirm-label="确认离开" bindconfirm="leave" bindcancel="cancelLeave"></confirm-sheet></view>
