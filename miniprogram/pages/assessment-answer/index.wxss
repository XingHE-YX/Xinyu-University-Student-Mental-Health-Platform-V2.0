.question { font-size:18px; line-height:28px; font-weight:500; margin-bottom:16px; }
.answer-actions { display:flex; gap:8px; align-items:center; margin-top:16px; }
.answer-actions .primary-button { flex:1; margin-top:0; }
.secondary-action { flex:1; height:48px; border:1px solid var(--xinyu-color-divider); border-radius:8px; background:var(--xinyu-color-surface); color:var(--xinyu-color-text); font-size:16px; line-height:46px; }
.secondary-action::after { border:0; }
.leave-action { width:100%; margin-top:16px; padding:0; border:0; background:transparent; color:var(--xinyu-color-text-secondary); font-size:14px; }
.leave-action::after { border:0; }
