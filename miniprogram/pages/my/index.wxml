<view class="page-container page-container--padded"><top-bar title="我的"></top-bar><view wx:if="{{loading}}" class="surface"><text class="muted">正在加载账户信息…</text></view><view wx:else class="surface"><view class="page-shell__title page-shell__title--compact">{{profile.displayName || '匿名同学'}}</view><view class="muted">{{profile.accountStatus === 'recovery' ? '账户处于 30 天恢复期' : '记录只属于你，树洞中只展示匿名身份'}}</view></view><state-message wx:if="{{error}}" title="账户信息暂时不可用" message="{{error}}" action-label="重新加载" bindaction="load"></state-message><view class="section-title">我的空间</view><view class="surface"><view class="link-row" data-path="/pages/anonymous-identity/index" bindtap="open"><text>匿名身份</text><text class="muted">›</text></view><view class="link-row" data-path="/pages/history/index" bindtap="open"><text>历史记录</text><text class="muted">›</text></view><view class="link-row" data-path="/pages/my-content/index" bindtap="open"><text>我的内容</text><text class="muted">›</text></view><view class="link-row" data-path="/pages/support-resources/index" bindtap="open"><text>支持资源</text><text class="muted">›</text></view><view class="link-row" data-path="/pages/privacy/index" bindtap="open"><text>数据与隐私</text><text class="muted">›</text></view></view><bottom-nav current="my"></bottom-nav></view>
