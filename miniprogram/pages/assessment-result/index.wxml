<view class="page-container page-container--padded"><top-bar title="观察结果"></top-bar><state-message wx:if="{{error}}" title="暂时无法展示" message="{{error}}" action-label="返回自测" bindaction="again"></state-message><view wx:if="{{result}}"><view class="surface"><view class="muted">{{result.title}} · {{result.completedAt}}</view><view wx:if="{{result.score !== null}}" class="result-score">{{result.score}}</view><view class="result-kind">{{result.kind === 'higher_score' ? '这次观察提示可以多留意' : result.kind === 'insufficient_data' ? '数据不足' : '本次观察已完成'}}</view><view class="result-text">{{result.interpretation}}</view><view wx:if="{{result.sleepDimensions}}" class="sleep-dimensions"><view wx:for="{{result.sleepDimensions}}" wx:key="name" class="link-row"><text>{{item.name}}</text><text class="muted">{{item.summary}}</text></view></view></view><view class="surface"><view class="section-title" style="margin-top:0">下一步</view><view class="muted">{{result.nextStep}}</view><view class="muted result-note">这是一次自我观察，不是诊断。你可以按自己的节奏决定是否寻求支持。</view></view><primary-button label="查看支持资源" bindaction="support"></primary-button><primary-button label="查看历史记录" secondary="true" bindaction="history"></primary-button><primary-button label="再做一次观察" secondary="true" bindaction="again"></primary-button></view></view>
