<view class="page-container page-container--padded"><top-bar title="观察结果"></top-bar><state-message wx:if="{{error}}" title="暂时无法展示" message="{{error}}" action-label="返回自测" bindaction="again"></state-message><view wx:if="{{result}}"><view class="surface"><view class="muted">{{result.title}} · {{result.completedAt}}</view><view wx:if="{{result.score !== null}}" class="result-score">{{result.score}}</view><view class="result-kind">{{result.kind === 'higher_score' ? '这次观察提示可以多留意' : result.kind === 'insufficient_data' ? '数据不足' : '本次观察已完成'}}</view><view class="result-text">{{result.interpretation}}</view><view wx:if="{{result.sleepDimensions}}" class="sleep-dimensions"><view wx:for="{{result.sleepDimensions}}" wx:key="name" class="link-row"><text>{{item.name}}</text><text class="muted">{{item.summary}}</text></view></view></view><view wx:if="{{result.aiAssist && result.kind !== 'safety_support' && result.module !== 'sleep'}}" class="surface ai-assist"><view class="section-title" style="margin-top:0">辅助说明</view><view wx:if="{{result.aiAssist.status === 'adopted'}}"><view class="result-text">{{result.aiAssist.summary}}</view><view wx:if="{{result.aiAssist.observations && result.aiAssist.observations.length}}" class="ai-list"><view wx:for="{{result.aiAssist.observations}}" wx:key="*this" class="ai-list__item">{{item}}</view></view><view wx:if="{{result.aiAssist.practicalSteps && result.aiAssist.practicalSteps.length}}" class="ai-steps"><view class="muted">可以考虑</view><view wx:for="{{result.aiAssist.practicalSteps}}" wx:key="*this" class="ai-list__item">{{item}}</view></view><view class="muted result-note">{{result.aiAssist.boundaryNotice}}</view></view><view wx:else class="muted">{{result.aiAssist.fallbackCopy || 'AI 辅助解读暂时不可用，当前使用固定规则说明'}}</view></view><view class="surface"><view class="section-title" style="margin-top:0">下一步</view><view class="muted">{{result.nextStep}}</view><view class="muted result-note">这是一次自我观察，不是诊断。你可以按自己的节奏决定是否寻求支持。</view></view><primary-button label="查看支持资源" bindaction="support"></primary-button><primary-button label="查看历史记录" secondary="true" bindaction="history"></primary-button><primary-button label="再做一次观察" secondary="true" bindaction="again"></primary-button></view></view>
