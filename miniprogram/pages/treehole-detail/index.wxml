<view class="page-container page-container--padded"><top-bar title="帖子详情" back="true"></top-bar><state-message wx:if="{{error}}" title="帖子暂时不可见" message="{{error}}" action-label="重新加载" bindaction="load"></state-message><view wx:if="{{loading}}" class="surface"><text class="muted">正在读取允许展示的内容…</text></view><view wx:elif="{{post}}"><view class="surface"><view class="post__meta"><text>{{post.displayName}}</text><text class="status-chip">{{post.status === 'published' ? '已公开' : post.status === 'protected' ? '保护展示' : '当前不可见'}}</text></view><view wx:if="{{post.body}}" class="post-body">{{post.body}}</view><view wx:else class="muted">这条内容当前只提供摘要，正文暂不展示。</view><view class="muted">{{post.createdAt}}</view></view><view class="section-title">回应</view><view wx:for="{{post.responses}}" wx:key="id" class="surface response"><view class="muted">{{item.displayName}}</view><view>{{item.body}}</view></view><view wx:if="{{!post.responses || !post.responses.length}}" class="muted">暂时还没有回应。</view><view wx:if="{{post.mine}}" class="surface"><button class="manage-action" bindtap="manage">管理这条内容</button></view><view wx:if="{{!post.mine}}" class="surface"><textarea class="textarea response-input" maxlength="500" value="{{response}}" bindinput="input" placeholder="写一句温和的回应"></textarea><primary-button label="提交回应" loading="{{responding}}" disabled="{{!response}}" bindaction="submitResponse"></primary-button></view></view></view>
