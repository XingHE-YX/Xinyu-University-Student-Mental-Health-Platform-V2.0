.mood-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 20px;
}
.mood-option {
  display: flex;
  align-items: center;
  min-height: 52px;
  padding: 0 12px;
  box-sizing: border-box;
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
  background: var(--xinyu-color-surface);
  color: var(--xinyu-color-text);
  font-size: 16px;
  line-height: 26px;
}
.mood-option--selected {
  border-color: var(--xinyu-color-primary);
  background: var(--xinyu-color-primary-soft);
  color: var(--xinyu-color-primary-pressed);
}
.mood-option__mark {
  width: 24px;
  color: var(--xinyu-color-primary);
}
.reading-block--mood {
  padding-top: 0;
  border-top: 0;
}
.reading-block__action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48px;
  margin-top: 8px;
  color: var(--xinyu-color-primary);
  font-size: 16px;
  line-height: 26px;
}
.reading-block__chevron {
  font-size: 24px;
  line-height: 24px;
}
.mood-sheet {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
.mood-sheet__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(31, 45, 43, 0.28);
}
.mood-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 90vh;
  max-width: 480px;
  margin: 0 auto;
  overflow-y: auto;
  padding: 24px 20px calc(20px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 8px 8px 0 0;
  background: var(--xinyu-color-surface);
}
.mood-sheet__eyebrow {
  display: block;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.mood-sheet__title {
  display: block;
  margin-top: 4px;
  color: var(--xinyu-color-text);
  font-size: 20px;
  line-height: 30px;
  font-weight: 500;
}
.mood-sheet__hint {
  display: block;
  margin-top: 12px;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.mood-sheet__error {
  display: block;
  margin-top: 8px;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.mood-sheet__primary,
.mood-sheet__secondary {
  width: 100%;
  height: 48px;
  margin-top: 16px;
  border: 0;
  border-radius: 8px;
  font-size: 16px;
  line-height: 48px;
}
.mood-sheet__primary {
  background: var(--xinyu-color-primary);
  color: var(--xinyu-color-surface);
}
.mood-sheet__primary[disabled] {
  background: var(--xinyu-color-primary-soft);
  color: var(--xinyu-color-text-muted);
}
.mood-sheet__secondary {
  margin-top: 8px;
  background: transparent;
  color: var(--xinyu-color-text-secondary);
}
.mood-sheet__primary::after,
.mood-sheet__secondary::after {
  border: 0;
}
