page {
  --xinyu-color-paper: #f7f4ee;
  --xinyu-color-surface: #ffffff;
  --xinyu-color-text: #1f2d2b;
  --xinyu-color-text-secondary: #5f6e6a;
  --xinyu-color-text-muted: #8c9a96;
  --xinyu-color-primary: #2e6f68;
  --xinyu-color-primary-pressed: #245b55;
  --xinyu-color-primary-soft: #e8f0ec;
  --xinyu-color-divider: #d7e4df;
  --xinyu-color-safety: #b85c4a;
  --xinyu-color-safety-soft: #f5e7e3;
  --xinyu-color-caution: #c58a3d;
  --xinyu-color-caution-soft: #f6eedb;
  --xinyu-font-sans:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', sans-serif;
  --xinyu-space-1: 4px;
  --xinyu-space-2: 8px;
  --xinyu-space-3: 12px;
  --xinyu-space-4: 16px;
  --xinyu-space-5: 20px;
  --xinyu-space-6: 24px;
  --xinyu-space-8: 32px;
  --xinyu-space-10: 40px;
  --xinyu-space-12: 48px;
  --xinyu-space-16: 64px;
  background: var(--xinyu-color-paper);
  color: var(--xinyu-color-text);
  font-family: var(--xinyu-font-sans);
  font-size: 16px;
  line-height: 1.625;
}

/* Main pages share this layout directly; it cannot live only in a component stylesheet. */
.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--xinyu-color-paper);
  color: var(--xinyu-color-text);
}

.page-container--padded {
  padding: 24px 20px calc(88px + env(safe-area-inset-bottom));
}

/* The native tab bar already reserves its own space below the page viewport. */
.page-container--main {
  max-width: 480px;
  margin: 0 auto;
  padding-top: 20px;
  padding-bottom: 32px;
}

@media (min-width: 393px) {
  .page-container--padded {
    padding-left: 24px;
    padding-right: 24px;
  }
}

@media (max-width: 359px) {
  .page-container--padded {
    padding-left: 16px;
    padding-right: 16px;
  }
}

.page-heading {
  margin-bottom: 24px;
}
.page-heading__date {
  display: block;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.page-heading__title {
  display: block;
  margin-top: 2px;
  color: var(--xinyu-color-text);
  font-size: 28px;
  line-height: 38px;
  font-weight: 600;
}
.page-heading__greeting {
  display: block;
  margin-top: 4px;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}
.page-intro {
  margin: -12px 0 24px;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}
.page-intro__line {
  display: block;
}

.reading-block {
  padding: 20px 0;
  border-top: 1px solid var(--xinyu-color-divider);
}
.reading-block:last-of-type {
  border-bottom: 1px solid var(--xinyu-color-divider);
}
.reading-block__label {
  display: block;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.reading-block__title {
  display: block;
  margin-top: 4px;
  color: var(--xinyu-color-text);
  font-size: 20px;
  line-height: 30px;
  font-weight: 500;
}
.reading-block__body {
  display: block;
  margin-top: 8px;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}
.reading-block__body--strong {
  color: var(--xinyu-color-text);
}
.content-section {
  margin-top: 32px;
}
.content-section__title {
  display: block;
  margin-bottom: 12px;
  color: var(--xinyu-color-text);
  font-size: 18px;
  line-height: 28px;
  font-weight: 500;
}
.content-section__hint {
  display: block;
  margin-top: 8px;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}

.plain-list {
  border-top: 1px solid var(--xinyu-color-divider);
}
.plain-list__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60px;
  padding: 12px 0;
  box-sizing: border-box;
  border-bottom: 1px solid var(--xinyu-color-divider);
}
.plain-list__item > view {
  min-width: 0;
  flex: 1;
  overflow-wrap: break-word;
}
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.section-heading .content-section__title {
  margin-bottom: 0;
}
.section-heading__action {
  flex: 0 0 auto;
  min-height: 44px;
  margin: 0 0 0 12px;
  padding: 8px 0 8px 8px;
  background: transparent;
  color: var(--xinyu-color-primary);
  font-size: 14px;
  line-height: 28px;
}
.section-heading__action::after {
  border: 0;
}
.plain-list__item--stacked {
  display: block;
  min-height: 76px;
}
.plain-list__title {
  display: block;
  color: var(--xinyu-color-text);
  font-size: 16px;
  line-height: 26px;
}
.plain-list__meta {
  display: block;
  margin-top: 2px;
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.plain-list__status {
  display: block;
  margin-top: 4px;
  color: var(--xinyu-color-text-muted);
  font-size: 14px;
  line-height: 22px;
}
.plain-list__chevron {
  flex: 0 0 auto;
  margin-left: 16px;
  color: var(--xinyu-color-text-secondary);
  font-size: 22px;
  line-height: 22px;
}

.inline-error {
  margin-top: 16px;
  padding: 12px 0;
  border-top: 1px solid var(--xinyu-color-divider);
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.inline-error__action {
  min-height: 44px;
  margin: 4px 0 0;
  padding: 8px 0;
  border: 0;
  background: transparent;
  color: var(--xinyu-color-primary);
  font-size: 14px;
  line-height: 28px;
  text-align: left;
  text-decoration: underline;
}
.inline-error__action::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: var(--xinyu-space-8) var(--xinyu-space-5)
    calc(var(--xinyu-space-16) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--xinyu-space-16) + env(safe-area-inset-bottom));
}

.page-shell__title {
  margin: 0;
  color: var(--xinyu-color-text);
  font-size: 24px;
  font-weight: 600;
  line-height: 34px;
}

.page-shell__description {
  margin: var(--xinyu-space-3) 0 0;
  color: var(--xinyu-color-text-secondary);
  font-size: 16px;
  line-height: 26px;
}

.section-title {
  margin: 24px 0 12px;
  color: var(--xinyu-color-text);
  font-size: 18px;
  line-height: 28px;
  font-weight: 500;
}
.section-title--first {
  margin-top: 0;
}
.page-shell__description--first {
  margin-top: 0;
}
.page-shell__title--compact {
  font-size: 20px;
  line-height: 30px;
}
.muted {
  color: var(--xinyu-color-text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.surface {
  padding: 20px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
}
.surface + .surface {
  margin-top: 12px;
}
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 52px;
  border-bottom: 1px solid var(--xinyu-color-divider);
  color: var(--xinyu-color-text);
}
.link-row:last-child {
  border-bottom: 0;
}
.status-chip {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 4px;
  background: var(--xinyu-color-primary-soft);
  color: var(--xinyu-color-primary-pressed);
  font-size: 12px;
  line-height: 18px;
}
.status-chip--waiting {
  background: var(--xinyu-color-caution-soft);
  color: var(--xinyu-color-caution);
}
.status-chip--safety {
  background: var(--xinyu-color-safety-soft);
  color: var(--xinyu-color-safety);
}
.textarea {
  width: 100%;
  min-height: 180px;
  box-sizing: border-box;
  padding: 12px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
  font-size: 16px;
  line-height: 26px;
}
.input {
  width: 100%;
  box-sizing: border-box;
  height: 48px;
  margin-top: 8px;
  padding: 0 12px;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
  font-size: 16px;
}
.option {
  display: flex;
  align-items: center;
  min-height: 52px;
  margin-top: 8px;
  padding: 0 16px;
  box-sizing: border-box;
  background: var(--xinyu-color-surface);
  border: 1px solid var(--xinyu-color-divider);
  border-radius: 8px;
  color: var(--xinyu-color-text);
}
.option--selected {
  border: 2px solid var(--xinyu-color-primary);
  background: var(--xinyu-color-primary-soft);
  color: var(--xinyu-color-primary-pressed);
}
.progress {
  height: 4px;
  margin: 16px 0 24px;
  background: var(--xinyu-color-divider);
  border-radius: 4px;
  overflow: hidden;
}
.progress__bar {
  height: 100%;
  background: var(--xinyu-color-primary);
}
.progress-segments {
  display: flex;
  gap: 4px;
  margin: 16px 0 24px;
}
.progress-segment {
  flex: 1;
  height: 4px;
  background: var(--xinyu-color-divider);
  border-radius: 4px;
}
.progress-segment--active {
  background: var(--xinyu-color-primary);
}
.resource + .resource {
  margin-top: 12px;
}
