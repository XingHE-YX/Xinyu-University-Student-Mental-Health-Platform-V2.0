<view wx:if="{{visible}}" class="confirm-sheet"><view class="confirm-sheet__mask" bindtap="cancel"></view><view class="confirm-sheet__panel"><text class="confirm-sheet__title">{{title}}</text><text class="confirm-sheet__message">{{message}}</text><view class="confirm-sheet__actions"><button class="confirm-sheet__cancel" bindtap="cancel">取消</button><button class="confirm-sheet__confirm" bindtap="confirm">{{confirmLabel}}</button></view></view></view>
